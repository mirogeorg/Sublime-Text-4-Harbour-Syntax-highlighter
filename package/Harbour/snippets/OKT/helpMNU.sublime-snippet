	<description>Цяло MNU със запомняне</description>
	<content><![CDATA[// START HELPMNU =============================================
function sprX()
#include "HBHASH.ch"
local cMEM := "~HIzFRjcq23nZ0gTvnxLN3TYv7mMo8sEh.bin"
local aItems, aSelec, aCargo	
local cCargo
local cMNUGoto    := ""
local nMNUGoto
local GetList     := {}	
local hData, s, a, c
local lF10Pressed := .f.
local lRefresh
local lValidated
local mnu
local nAligned
local nKeyExt
local nKey
local nWidth, nHeight
local _last, hRec
local lKeyEnter
local lKeyLeft 
local lKeyRight
local lDBFEdited
local lExit

	SaveColor00()
	SaveColor()
	color( COLOR_NORMAL, GROUP_BLUE )
	mnu := mnuInit()
	mnuModify( mnu, { ;
						{ "WinStatus",          {{ "F10", "Към обработка" }, { "ESC", "Изход" }} },;
						{ "WinTitle",           "Движение на МПС - Варна" },;
						{ "chCustomSelector",   { |x, nLine| if( hb_isString( aCargo[ nLine ] ) .and. Left( aCargo[ nLine ], 2 ) == "<>", x, Remove3( x ) ) } },;
						{ "chExtendedSearch",   .F. },;
						{ "chSolidSelect",      .t. },;
						{ "chSearch",           .F. },;
						{ "chUnknownExit",      .t. },;
						{ "mnCenteredItems",    .f. } } )
						{ "chExtendedExitKeys", { KX_F10, KX_NUM_LEFT, KX_MID_LEFT, KX_NUM_RIGHT, KX_MID_RIGHT } },;
						// { "chSolidSelect",    { |x| x != KX_TAB } },;
						// { "WinY1",           1 },;
						//{ "mnBorder",         0 },;
						// { "WinX1",           3 },;
						// { "WinXOffset",      -20 },;
						// { "WinYOffset",      -5 },;
						// { "mnBorder",        0 },; //bez border, platno do raba na ekrana
						// { "chRedefineLEFT",   { |x| x == KX_CTRL_MID_LEFT  .or. x == KX_CTRL_NUM_LEFT } },;
						// { "chRedefineRIGHT",  { |x| x == KX_CTRL_MID_RIGHT .or. x == KX_CTRL_NUM_RIGHT } },;
						// { "chHorizStep",     5 },;

	hData := MEMLoad( cMEM, {;
					 "cFIRMA"   => "",;
					 "cNOMERF"  => "",;
					 "dNDA"     => BOM( Date() ),;
					 "dKDA"     => EOM( Date() ),;
					 "nSprType" => SPR_WMPS;
					} )
	
	lRefresh := .t.
	Color00( 6, 12 )
	Color00( 7, 14 )
	
	//pri sin
	Color00( 8,  9 )
	Color00( 9, 14, 9 ) //лента за избор със стрелки
	
	//pri cherven
	//Color00(  8, 3 )
	//Color00(  9, 0, 11 ) //лента за избор със стрелки
	
	//pri rozov prozorec
	//Color00( 8,  0 )
	//Color00( 9, 14, 13 ) //лента за избор със стрелки
	repeat
		aItems := {}
		aSelec := {}
		aCargo := {}


		lValidated := .t.

		c := ""
		if Empty( hRec[ "KATEGORIQ" ] )
			if lF10Pressed
				c := "°6(въведете задължително)°6"
			endif
			lValidated := .f.
		else
			c := "°7" + Str_( hRec[ "KATEGORIQ" ] ) + "°71"
		endif
		aAdd( aItems, "Категория:: " + c )
		aAdd( aCargo, "KATEGORIQ" )
		aAdd( aSelec, .T. )
	
		
		aAdd( aItems, "Период:: °7" + DtoC( hData[ "dNDA" ] ) + " - " + DtoC( hData[ "dKDA" ] ) + "°7")
		aAdd( aCargo, "PERIOD" )
		aAdd( aSelec, .T. )
		
		aVIDChoices := { SPR_WMPS, SPR_SUMARNA, SPR_CHAST }
		c := Izbor2Str( { " Движение по МПС ", " Сумарна рекапитулация за МПС ", " Частично разтоварени МПС " }, aVIDChoices, hData[ "nSprType" ], "°8", "°9" )
		aAdd( aItems, "Вид на справката:: " + c )
		aAdd( aCargo,  "<>VID" )
		aAdd( aSelec, .T. )
		
		nWidth  := Min( MaxCol() + 1, 95 )
		nHeight := Min( MaxRow() + 1, Len( aItems ) + 2 )  
		mnuModify( mnu, { { "chItems",      aItems },;
						  { "chSelectable", aSelec },;
						  { "mnCargo",      aCargo },;
						  { "mnHeight",     nHeight },;
					      { "mnWidth",      nWidth },; 
						  { "chInitItem",   2 } } )
		if !Empty( cMNUGoto )
			nMNUGoto := hb_aScan( aCargo, { |x| x == cMNUGoto } )
			if nMNUGoto == 0
				?"ne namiram cMNUGoto =", cMNUGoto
				wait
				//DoLog( { "FILE" => "hzemq.log", "TYPE" => "CRITICAL", "BODY" => "rtchWly6Owa3bFlN2gUoFEmgnZnmf5dz Ne namiram cargo = '" + cMNUGoto + "'" } )
			else
				mnuModify( mnu, { { "mnSetInitItem", nMNUGoto } } )
			endif
			cMNUGoto := ""
		endif	
		
		nAligned := mnuAlignSemicolon( mnu )
		mnuLaunch( mnu )
		
		nKeyExt := mnuLastKey()
		lKeyEnter := nKeyExt == KX_ENTER     .or. nKeyExt == KX_NUM_ENTER
		lKeyLeft  := nKeyExt == KX_NUM_LEFT  .or. nKeyExt == KX_MID_LEFT
		lKeyRight := nKeyExt == KX_NUM_RIGHT .or. nKeyExt == KX_MID_RIGHT

		if mnuCancelled( mnu )
			lExit := .f.
			lDBFEdited := !hb_Serialize( hRec ) == cRecOriginal
			if lDBFEdited
				Color(, GROUP_LRED )
				if msgBox( { "Незаписани промени. Изход без запис?" ,;
						{ "msHDefaultESC", 1 },;
						{ "msHInit",       2 },;
						{ "msHItems",      { "Изход без запис", "Остани в документа" } } ,;
						{ "msAllowESC",    .t. } } ) = 1
					lExit := .t.
				endif
			else
				lExit := .t.
			endif
			if lExit
				exit
			endif
		else
			cCargo       := mnuGetCargo( mnu )
			do case
				case !Left( cCargo, 2 ) == "<>" .and. aScan( { KX_NUM_LEFT, KX_MID_LEFT, KX_NUM_RIGHT, KX_MID_RIGHT }, nKeyExt,,,.t. ) <> 0
					//streklite rabotqt samo kadeto trqbwa

				case  Left( cCargo, 2 ) == "<>" .and. ( nKeyExt == KX_ENTER .or. nKeyExt == KX_NUM_ENTER )
					mnuInskey( KX_MID_DOWN )

				case nKeyExt == KX_F10
					lF10Pressed := .t.
					if lValidated
						
						// select RZEMIMOT
						// if lNew
						//	
						// else
						// dbGoTo( nRec )
						// endif
						// Hash2Rec( hRec )
						
						MEMSave( cMEM, hData )
						exit
					else
						Color(, GROUP_RED )
						MSGBox( { "Не са попълнени всички задължителни данни. Моля коригирайте." ,;
								{ "msHDefaultESC", 0 },;
								{ "msHItems", { "Натиснете ENTER" } } ,;
								{ "msAllowESC", .t. } } )
					endif

				case cCargo == "FIRMA" .and. ( nKeyExt == KX_ENTER .or. nKeyExt == KX_NUM_ENTER )
					
					GET FIRMA to S init "" MAIN { 4,22 ,GROUP_RED }

					if s <> nil   /// ако не сме натиснали ESC
						hData[ "cNOMERF" ] := s[ LOADFIR_NOMER ]
						hData[ "cFIRMA"  ] := s[ LOADFIR_FIRMA ]
						mnuInsKey( KX_MID_DOWN )
					endif
				
				case cCargo == "PERIOD" .and. lKeyEnter
				
					color( COLOR_NORMAL, GROUP_RED )
					a := PERIOD1( "~3132300.bin" )
					if a <> nil
						hData[ "dNDA" ] := a[ 1 ]
						hData[ "dKDA" ] := a[ 2 ]
						mnuInsKey( KX_MID_DOWN )
					endif
				
				case cCargo == "PERIOD" .and. lKeyEnter

					color( COLOR_NORMAL, GROUP_RED )
					a := Period2Time( "zefau6vdMwaceWdYoDJXsqwC98889H4z.tmp" )
					if a <> nil
						dNDA := PRMSGet( a, "P2_NDA" )
						nNVR := PRMSGet( a, "P2_NVR" )

						dKDA := PRMSGet( a, "P2_KDA" )
						nKVR := PRMSGet( a, "P2_KVR" )

						mnuInsKey( KX_MID_DOWN )
					endi
					
				case cCargo == "REKOLTA" .and. lKeyEnter
					Color(, GROUP_RED)
					a := Rekizbor( 1, hData[ "nRekolta" ] )
					if a <> nil
						hData[ "nRekolta" ] := a[ REKIZBOR_GODINA ]
						mnuInsKey( KX_MID_DOWN )
					endif
					
				case cCargo == "REKOLTA" .and. lKeyEnter
					color( ,GROUP_PURPLE )
					_last := msgBox( { "Стопанска година: ÷   ",;
									 { "WinStatus", { {"+, -", "бърза смяна" } } },;
									 { "WinY1", IIF( (a3GetLastY() + 1+3) > MaxCol(), (a3GetLastY() -5 ),(a3GetLastY() +1)) } } )
									 // { "WinX1", nAlign + 3 } } )
					
					@ @@1 get RZDOGPLA->REKOLTA send reader := IncReader() valid RZDOGPLA->REKOLTA >= ZDOGIMOT_MINYEAR .and. RZDOGPLA->REKOLTA <= DBF_GLOBALMAXYEAR
					READ
					if !LastKey() == K_ESC// .and. nNew <> nOld
						mnuInsKey( KX_MID_DOWN )
					endif
					winClose()
					
				case cCargo == "DAT" .and. lKeyEnter
					color( ,GROUP_RED )
					_last := msgBox( { "Дата: ÷" + Space( 9 ) } )
					
					@ @@1 get hRec[ "DAT" ] 
					READ
					if !LastKey() == K_ESC
						mnuInsKey( KX_MID_DOWN )
					endif
					winClose()
					
				case cCargo == "EKATTE" .and. lKeyEnter
					nID := 0
					s   := EKT4EKATTE( EKATTE )
					if s <> nil
						nID := s[ "ID" ]
					endif
					
					GET EKT to S INITID nID
					if s <> nil 
						replace EKATTE  with s[ "EKATTE" ] 
						mnuInsKey( KX_MID_DOWN )
						
					endif

				case cCargo == "<>VIDPLA" 
					if lKeyLeft
						replace VIDPLA with mnuTableCheckBoundaries( aVIDPLAChoices, VIDPLA ) //first put into boundaries if outside
						replace VIDPLA with mnuTableMove( aVIDPLAChoices, VIDPLA, -1 )        //then move inside boundaries
					elseif lKeyRight 
						replace VIDPLA with mnuTableCheckBoundaries( aVIDPLAChoices, VIDPLA ) //first put into boundaries if outside
						replace VIDPLA with mnuTableMove( aVIDPLAChoices, VIDPLA, +1 )        //then move inside boundaries
					endif
					
			endcase
		endif
	until .f.
	mnuFinish( mnu )
	RestColor()
	RestColor00()
return nil
//END HELPMNU ===================================================================================]]></content>
