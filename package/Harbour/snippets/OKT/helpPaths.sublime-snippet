<snippet>
	<description>Paths</description>
	<content><![CDATA[hb_osPathSeparator()
		hb_DirSepAdd( cEXEPath )
		
		hData[ "cRootPath" ] := hb_PathNormalize( hb_DirSepToOS( hb_FNameDir( EXEName() ) + "../" ) ) //vzimame edna papka po-nagore
		hb_FNameMerge( <cPath>, <cFileName>, <cExt> ) -> cResult
		nResult := hb_vfRename( cOutputFile, hb_FNameExtSet( cOutputFile,".xlsx" ) )
		
		aKant := Directory( cPath + "\KANT??.dbf" )
		for aK := 1 to len( aKant )
			name := aKant[ aK, 1 ]
		next
		
		hb_FGetDateTime( cPath + "export.txt", @tTime )
		c := '="' + hb_TtoC( tTime,"DD.MM.YYYY [H[H][:M[M][:S[S]" ) + '"'
		
		hb_FNameSplit( cInFile, @cPath, @cFile, @cExt )
		
		t := t"0000-00-00"
		if !hb_vfTimeGet( cInFile, @t )
		endif
		
		cFile := WIN_GETOPENFILENAME(, 'Главен файл Горива', cPath , "", "*.xlsx; *.xls" )//,;
		if !Empty( cFile )
			hData[ "cFileGoriva" ] := cFile
			mnuInsKey( KX_MID_DOWN )
		endif
		
		
		]]></content>
	<tabTrigger>helpPaths</tabTrigger>
	<scope>source.harbour</scope>
</snippet>